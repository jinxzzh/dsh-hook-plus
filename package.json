{
  "name": "dsh-hook-plus",
  "version": "0.1.0",
  "description": "DeepSeek Harness 生命周期钩子：拦截危险命令、改写工具参数与结果、响应会话事件、长任务结束时自动唤醒模型。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "hooks",
    "lifecycle",
    "automation",
    "rewake"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "hooks",
    "examples",
    "cordis.patch.yml",
    "market/index.json",
    "skill/SKILL.md",
    "icon.svg",
    "README.md",
    "README_EN.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/",
    "check": "node --check lib/plus-format.js && node --check lib/plus-load.js && node --check lib/plus-match.js && node --check lib/plus-exec.js && node --check lib/plus-eval.js && node --check lib/plus-events.js && node --check lib/index.js"
  },
  "author": "jinxzzh",
  "icon": "./icon.svg",
  "homepage": "https://github.com/jinxzzh/dsh-hook-plus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinxzzh/dsh-hook-plus.git"
  },
  "bugs": {
    "url": "https://github.com/jinxzzh/dsh-hook-plus/issues"
  }
}
